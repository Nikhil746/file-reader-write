<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Note</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-gray-100">
    <div class="min-h-screen w-full p-4 sm:p-8 max-w-4xl mx-auto">
        <h1 class="text-2xl font-semibold text-gray-800 mb-6">My Notes</h1>

        <form method="POST" action="/create" class="bg-white rounded-lg shadow p-4 mb-8 flex flex-col gap-3">
            <input
                class="px-3 py-2 rounded-md border border-gray-300 outline-none focus:border-blue-500 text-gray-800"
                name="title" type="text" placeholder="Note title" required />
            <textarea
                class="px-3 py-2 rounded-md border border-gray-300 outline-none focus:border-blue-500 text-gray-800 resize-none"
                name="content" rows="3" placeholder="Add your notes"></textarea>
            <input type="submit" value="Add Note"
                class="self-start px-4 py-2 rounded-md bg-blue-500 text-white text-sm font-medium hover:bg-blue-600 transition" />
        </form>

        <div class="flex gap-4 flex-wrap">
            <% if (files.length > 0) { %>
                <% files.forEach((file) => { %>
                    <div class="w-64 bg-white rounded-lg shadow p-4">
                        <h2 class="font-semibold text-gray-800 mb-1"><%= file %></h2>
                        <p class="text-gray-500 text-sm"><%= file.content %></p>
                        <div class="flex w-full justify-between items-center">
                            <a class="text-gray-500 text-sm" href="/files/<%= file %>"/> Read More...
                            <a class="text-gray-500 text-sm" href="/edit/<%= file %>"/> Edit
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="text-gray-500">No notes added yet...</div>
            <% } %>
        </div>
    </div>
</body>

</html>